# Copy to .env.local and fill in. NEVER commit real values. Everything here is SANDBOX / test only.
DATABASE_URL="file:./dev.db"

# --- PayPal SANDBOX app (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=            # same value as PAYPAL_CLIENT_ID (used by the JS SDK Smart Buttons)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                       # optional: webhook id for signature verification (needs a public URL)
# Optional "judge seat": a vaulted sandbox wallet so the 90-second story can authorize without the popup.
# Create it once with scripts/paypal/vault-setup.mts (see README).
PAYPAL_SEAT_VAULT_ID=
# Optional: sandbox buyer shown in the approve dialog for reviewers (a SANDBOX account only, never a real one)
NEXT_PUBLIC_SANDBOX_BUYER_EMAIL=
NEXT_PUBLIC_SANDBOX_BUYER_PASSWORD=
# Optional: sandbox test card (server-side authorization in one sample case)
PAYPAL_TEST_CARD=
PAYPAL_TEST_CARD_EXP=
# Optional: multiparty / Partner Referrals (needs PayPal partner approval)
MULTIPARTY=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BN_CODE=

# --- Anthropic (set a spend limit in the Console) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
READER_MODEL=claude-opus-5-5

# --- AG Grid Enterprise license (optional; without it a trial watermark is shown) ---
NEXT_PUBLIC_AG_GRID_LICENSE=

# --- Deployment (optional) ---
PUBLIC_BASE_URL=                         # e.g. https://signclear.onrender.com (used by the API/MCP docs)
TRUST_PROXY=                             # set to 1 behind a reverse proxy (rate limits use X-Forwarded-For)
